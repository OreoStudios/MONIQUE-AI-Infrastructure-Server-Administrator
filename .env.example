# Rename to .env and replace EVERY value below before starting.
# Use: openssl rand -hex 32  (for MONIQUE_ADMIN_TOKEN)
# Use: openssl rand -base64 32  (for MONIQUE_ENCRYPTION_KEY_BASE64)
MONIQUE_ADMIN_TOKEN=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MONIQUE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_EXACTLY_32_RANDOM_BYTES
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_RANDOM_DB_PASSWORD
MONIQUE_WEB_ORIGIN=http://localhost:5173
# Optional AI connectors; without credentials, AI chat responds 503.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MONIQUE_CLAUDE_MODEL=claude-sonnet-4-5
# MONIQUE sysadmin planning: strongest available OpenAI reasoning model; billed by tokens.
MONIQUE_CODEX_MODEL=gpt-6.2-astra
MONIQUE_CODEX_REASONING_EFFORT=max
MONIQUE_CODEX_MAX_OUTPUT_TOKENS=16000
# Realtime voice model and voice; requires OPENAI_API_KEY and microphone permission.
MONIQUE_VOICE_MODEL=gpt-realtime-2.1-mini
MONIQUE_VOICE_NAME=marin
